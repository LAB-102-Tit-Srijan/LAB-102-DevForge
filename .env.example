# ===========================================
# SheriSense Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# Groq API (LLM + Whisper Transcription)
# Get your key at: https://console.groq.com/keys
# Used for: Llama 3.3 70B chat, Whisper transcription
# -------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# -------------------------------------------
# MongoDB Atlas (metadata storage)
# Create a free cluster at: https://cloud.mongodb.com
# -------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sherisense?retryWrites=true&w=majority

# -------------------------------------------
# Redis (caching & job queue)
# Default: runs in Docker via docker-compose
# -------------------------------------------
REDIS_URL=redis://redis:6379

# -------------------------------------------
# ChromaDB (vector database)
# Default: runs in Docker via docker-compose
# -------------------------------------------
CHROMA_URL=http://chromadb:8000

# -------------------------------------------
# Server Configuration
# -------------------------------------------
PORT=5000
NODE_ENV=development

# -------------------------------------------
# File Storage
# -------------------------------------------
UPLOAD_DIR=./uploads
TEMP_DIR=./temp

# -------------------------------------------
# Frontend Configuration
# Used by Vite during build
# -------------------------------------------
VITE_API_URL=http://localhost:5000
